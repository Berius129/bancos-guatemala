	partition Cuentas = m
		mode: import
		source =
				let
					Origen = Csv.Document(Web.Contents(RutaDatos & "cuentas.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
					Tipos = Table.TransformColumnTypes(Encabezados, {
						{"fecha", type date},
						{"banco", type text},
						{"activo", type number},
						{"capital", type number},
						{"depositos", type number},
						{"disponibilidades", type number},
						{"cartera_bruta", type number},
						{"cartera_vencida", type number},
						{"estimaciones_cartera", type number},
						{"margen_operacional_bruto", type number},
						{"gastos_administracion", type number},
						{"utilidad_neta_acum", type number},
						{"utilidad_anualizada", type number},
						{"activo_promedio", type number},
						{"capital_promedio", type number}
					}, "en-US")
				in
					Tipos
