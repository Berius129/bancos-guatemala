table Cuentas
	lineageTag: 7418b843-3029-52f8-a673-61c79f3776da

	/// Fecha del corte más reciente en el contexto.
	measure 'Último corte' = MAX ( Fechas[fecha] )
		formatString: mmm yyyy
		displayFolder: Base
		lineageTag: e66e8ba3-8385-59e6-97c9-3bffc58f28a8

	/// Activo total en millones de quetzales (la SIB publica en miles).
	measure 'Activos (Q millones)' = VAR _f = MAX ( Fechas[fecha] ) RETURN CALCULATE ( SUM ( Cuentas[activo] ), Fechas[fecha] = _f ) / 1000
		formatString: #,0
		displayFolder: Base
		lineageTag: 567fab78-1c25-539e-9169-1d82df682299

	/// Utilidad neta acumulada en el año x 12 / mes del corte.
	measure 'Utilidad anualizada (Q millones)' = VAR _f = MAX ( Fechas[fecha] ) RETURN CALCULATE ( SUM ( Cuentas[utilidad_anualizada] ), Fechas[fecha] = _f ) / 1000
		formatString: #,0
		displayFolder: Base
		lineageTag: 7da9f01b-525a-55e1-acaa-6100d5746e94

	/// Bancos que reportan en el corte.
	measure 'Número de bancos' = VAR _f = MAX ( Fechas[fecha] ) RETURN CALCULATE ( DISTINCTCOUNT ( Cuentas[banco] ), Fechas[fecha] = _f )
		formatString: 0
		displayFolder: Base
		lineageTag: d1bb1386-1d61-5099-8423-39643cfae87b

	/// Utilidad anualizada / activo promedio (corte actual y anterior).
	measure 'ROA' = DIVIDE ( VAR _f = MAX ( Fechas[fecha] ) RETURN CALCULATE ( SUM ( Cuentas[utilidad_anualizada] ), Fechas[fecha] = _f ), VAR _f = MAX ( Fechas[fecha] ) RETURN CALCULATE ( SUM ( Cuentas[activo_promedio] ), Fechas[fecha] = _f ) )
		formatString: 0.00%
		displayFolder: Rentabilidad
		lineageTag: 8b4e9e5b-30a8-5b07-be2c-f18177ab9b31

	/// Utilidad anualizada / capital contable promedio.
	measure 'ROE' = DIVIDE ( VAR _f = MAX ( Fechas[fecha] ) RETURN CALCULATE ( SUM ( Cuentas[utilidad_anualizada] ), Fechas[fecha] = _f ), VAR _f = MAX ( Fechas[fecha] ) RETURN CALCULATE ( SUM ( Cuentas[capital_promedio] ), Fechas[fecha] = _f ) )
		formatString: 0.0%
		displayFolder: Rentabilidad
		lineageTag: fca8938c-ea1c-5db4-9438-95aaf7df7a34

	/// Gastos de administración / margen operacional bruto. Más bajo = mejor.
	measure 'Eficiencia' = DIVIDE ( VAR _f = MAX ( Fechas[fecha] ) RETURN CALCULATE ( SUM ( Cuentas[gastos_administracion] ), Fechas[fecha] = _f ), VAR _f = MAX ( Fechas[fecha] ) RETURN CALCULATE ( SUM ( Cuentas[margen_operacional_bruto] ), Fechas[fecha] = _f ) )
		formatString: 0.0%
		displayFolder: Rentabilidad
		lineageTag: 77de4f68-b136-53fb-9a8a-dba6b3ca3e21

	/// Cartera vencida / cartera bruta.
	measure 'Morosidad' = DIVIDE ( VAR _f = MAX ( Fechas[fecha] ) RETURN CALCULATE ( SUM ( Cuentas[cartera_vencida] ), Fechas[fecha] = _f ), VAR _f = MAX ( Fechas[fecha] ) RETURN CALCULATE ( SUM ( Cuentas[cartera_bruta] ), Fechas[fecha] = _f ) )
		formatString: 0.00%
		displayFolder: Riesgo
		lineageTag: fed3d6b0-e011-576e-8f0c-b8300ba974f5

	/// Estimaciones por valuación de cartera / cartera vencida.
	measure 'Cobertura' = DIVIDE ( VAR _f = MAX ( Fechas[fecha] ) RETURN CALCULATE ( SUM ( Cuentas[estimaciones_cartera] ), Fechas[fecha] = _f ), VAR _f = MAX ( Fechas[fecha] ) RETURN CALCULATE ( SUM ( Cuentas[cartera_vencida] ), Fechas[fecha] = _f ) )
		formatString: 0%
		displayFolder: Riesgo
		lineageTag: 71b30414-d42f-5b2f-b308-dabec9b7c25f

	/// Capital contable / activo total.
	measure 'Capital / activos' = DIVIDE ( VAR _f = MAX ( Fechas[fecha] ) RETURN CALCULATE ( SUM ( Cuentas[capital] ), Fechas[fecha] = _f ), VAR _f = MAX ( Fechas[fecha] ) RETURN CALCULATE ( SUM ( Cuentas[activo] ), Fechas[fecha] = _f ) )
		formatString: 0.0%
		displayFolder: Riesgo
		lineageTag: a2cdd3f9-417e-5f01-8470-788c6b3f9a32

	/// Qué proporción de lo captado está prestada.
	measure 'Cartera / depósitos' = DIVIDE ( VAR _f = MAX ( Fechas[fecha] ) RETURN CALCULATE ( SUM ( Cuentas[cartera_bruta] ), Fechas[fecha] = _f ), VAR _f = MAX ( Fechas[fecha] ) RETURN CALCULATE ( SUM ( Cuentas[depositos] ), Fechas[fecha] = _f ) )
		formatString: 0%
		displayFolder: Riesgo
		lineageTag: f764f604-182d-54a9-8bb5-5172fa35cf6f

	/// Activos del banco / activos del sistema en el mismo corte.
	measure 'Participación en activos' = DIVIDE ( [Activos (Q millones)], CALCULATE ( [Activos (Q millones)], ALL ( Bancos ) ) )
		formatString: 0.0%
		displayFolder: Mercado
		lineageTag: 035b821a-4800-5ac2-963a-94ea589deb95

	/// Índice Herfindahl-Hirschman sobre activos. <1,500 poco concentrado; 1,500-2,500 moderado.
	measure 'HHI' = SUMX ( VALUES ( Bancos[banco] ), ( 100 * CALCULATE ( [Participación en activos] ) ) ^ 2 )
		formatString: #,0
		displayFolder: Mercado
		lineageTag: 2a8e61f5-c1e7-53c3-a9f2-a9d9fec2987a

	/// Participación conjunta de los tres bancos más grandes.
	measure 'Participación top 3' =
			VAR _top = TOPN ( 3, ALL ( Bancos[banco] ), [Activos (Q millones)], DESC )
			RETURN DIVIDE ( CALCULATE ( [Activos (Q millones)], _top ), CALCULATE ( [Activos (Q millones)], ALL ( Bancos ) ) )
		formatString: 0.0%
		displayFolder: Mercado
		lineageTag: 4c8d2974-0067-5b6b-b179-6e70431885ad

	/// ROE del sistema completo, ignora el filtro de banco.
	measure 'ROE sistema' = CALCULATE ( [ROE], ALL ( Bancos ) )
		formatString: 0.0%
		displayFolder: Comparación
		lineageTag: 02dac85f-5069-5d9d-9a8d-d419bc428b46

	/// Morosidad del sistema completo.
	measure 'Morosidad sistema' = CALCULATE ( [Morosidad], ALL ( Bancos ) )
		formatString: 0.00%
		displayFolder: Comparación
		lineageTag: 1402845a-23c0-5872-8d0d-9b9cc65d0850

	/// Eficiencia del sistema completo.
	measure 'Eficiencia sistema' = CALCULATE ( [Eficiencia], ALL ( Bancos ) )
		formatString: 0.0%
		displayFolder: Comparación
		lineageTag: 3599291e-5997-5065-97e0-34b4a6370a97

